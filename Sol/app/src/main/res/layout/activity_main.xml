<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E7DDBB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ConstraintLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E7DDBB">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/viewtitulo" />

            <View
                android:id="@+id/view"
                android:layout_width="430dp"
                android:layout_height="68dp"
                android:background="#DCB57A"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="443dp"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="5dp"
                android:background="@color/cardview_shadow_end_color"
                android:minHeight="?attr/actionBarSize"
                android:theme="?attr/actionBarTheme"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:titleTextColor="#DBB47A" />

            <ImageView
                android:id="@+id/iconeSol"
                android:layout_width="160dp"
                android:layout_height="150dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/sol" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="152dp"
                android:layout_height="126dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="68dp"
                android:fontFamily="@font/clicker_script"
                android:text="Sol"
                android:textColor="#7A5F3E"
                android:textSize="96sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtitulo"
                android:layout_width="130dp"
                android:layout_height="34dp"
                android:layout_marginTop="116dp"
                android:layout_marginEnd="36dp"
                android:fontFamily="@font/coming_soon"
                android:text="Venha brincar!"
                android:textColor="#503622"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgJogos"
                android:layout_width="185dp"
                android:layout_height="159dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView"
                app:srcCompat="@drawable/videogame" />

            <Button
                android:id="@+id/btnJogos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/coming_soon"
                android:text="Jogos"
                android:textColor="#302517"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#DCB57A"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgJogos" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="184dp"
                android:layout_height="160dp"
                android:layout_marginTop="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnJogos"
                app:srcCompat="@drawable/carnaval" />

            <Button
                android:id="@+id/btnAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="60dp"
                android:fontFamily="@font/coming_soon"
                android:text="Avatares"
                android:textColor="#302517"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#DCB57A"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgAvatar" />

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="83dp"
                android:layout_height="80dp"
                android:layout_marginBottom="48dp"
                app:layout_constraintBottom_toTopOf="@+id/subtitulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/titulo"
                app:srcCompat="@drawable/cantinho" />

            <ImageButton
                android:id="@+id/btnCadastro"
                android:layout_width="43dp"
                android:layout_height="33dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="#E5DDB8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@android:drawable/list_selector_background" />

            <ImageView
                android:id="@+id/imgCadAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/cadastro" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>